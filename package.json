{
  "name": "csv-to-json",
  "productName": "CSV to JSON",
  "version": "1.0.0",
  "description": "A basic CSV to JSON converter app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mitch.csvtojson",
    "productName": "CSV to JSON",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
